<!-- wall.tmpl -->
{{ define "wall" }}
  <div class="box">
    <form action="{{ .Paths.WallModify }}"
              id="wall"
          method="post">
      <textarea class="wallContent"
                 form="wall"
            maxlength="{{ .Limit.WallLimits.LengthChars }}"
                 name="wall"
                title="edit wall content">
      {{- .Storage.WallContent -}}
      </textarea>
      {{- if .Storage.WallContent }}
      <p class="wallMeta">
        {{ .Storage.WallChars }}/{{ .Limit.WallLimits.LengthChars }}
        ({{ .Storage.WallCap }}%) &middot;
        {{ .Storage.WallModifiedTimeFmt }} &middot;
        {{ .Storage.WallModifiedUser }}
      </p>
      {{ end }}
      <div class="row">
        {{- if .Auth.Require.Wall }} {{ template "auth" . }} {{ end }}
        <button class="selectWallSave"
                title="save wall content"
                 type="submit">save</button>
      </div>
    </form>
    <form action="{{ .Paths.WallModify }}"
           class="inline-form"
          method="post">
      <input name="clear"
             type="hidden"
            value="true">
      <div class="row">
      {{- if .Auth.Require.Wall }} {{ template "auth" . }} {{ end }}
        <button class="selectClearWall"
        {{- if not .Storage.WallContent }} disabled
                title="no wall content to clear"
        {{- else }}
                title="clear wall content"
        {{- end }}
                 type="submit">clear</button>
      </div>
    </form>
    <form action="{{ .Paths.WallModify }}"
           class="inline-form"
          method="post">
      <div class="row">
        {{- if .Auth.Require.Wall }} {{ template "auth" . }} {{ end }}
        <input name="download"
               type="hidden"
              value="wall">
        <button class="selectDownload"
        {{- if not .Storage.WallContent }} disabled
                title="no wall content to download"
        {{- else }}
                title="download wall content"
        {{- end }}
                 type="submit">download</button>
      </div>
    </form>
  </div>
{{ end }}
